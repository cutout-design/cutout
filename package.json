{
  "name": "cutout",
  "productName": "Cutout",
  "version": "1.3.5",
  "description": "A lightweight raster scratchpad for designers",
  "author": "Cutout",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.mjs",
    "version": "node scripts/sync-version.js && git add cutout/version.js",
    "dist": "electron-builder --win --x64",
    "dist:arm64": "electron-builder --win --arm64 -c.nsis.artifactName=Cutout-${version}-arm64.${ext}",
    "dist:store": "electron-builder --win appx --x64 --arm64",
    "dist:mac": "electron-builder --mac --arm64"
  },
  "build": {
    "appId": "app.cutout",
    "productName": "Cutout",
    "copyright": "",
    "files": [
      "main.js",
      "preload.js",
      "cutout/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "installer"
    },
    "win": {
      "target": "nsis",
      "icon": "cutout/icons/icon.ico",
      "executableName": "Cutout"
    },
    "appx": {
      "identityName": "ggolcher.CutoutImageEditor",
      "publisher": "CN=5802E7E3-3744-4D6F-AAC6-4C9D807D1900",
      "publisherDisplayName": "ggolcher",
      "applicationId": "Cutout",
      "displayName": "Cutout Image Editor",
      "backgroundColor": "transparent",
      "languages": [
        "en-US"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "customExtensionsPath": "installer/appx-extensions.xml",
      "artifactName": "Cutout-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "installer/Cutout.icon",
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "artifactName": "Cutout-${version}.${ext}",
      "fileAssociations": [
        {
          "ext": "png",
          "name": "PNG image",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": [
            "jpg",
            "jpeg"
          ],
          "name": "JPEG image",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": "gif",
          "name": "GIF image",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": "webp",
          "name": "WebP image",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": "svg",
          "name": "SVG image",
          "role": "Editor",
          "rank": "Alternate"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": "always",
      "shortcutName": "Cutout",
      "runAfterFinish": true,
      "artifactName": "Cutout-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}

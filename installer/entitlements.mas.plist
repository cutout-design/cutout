<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Cutout, Mac App Store build: the app itself (main process).
     Only what Cutout uses:
     - app-sandbox: required for the Mac App Store.
     - files.user-selected.read-write: Save / Save as (NSSavePanel), the file picker, files dropped on the window.
       Files opened from Finder (Open With, double-click) are granted by macOS without an entitlement.
     - network.client: downloading the images in a pasted Figma copy (figma.js fetches Figma's https links).
     com.apple.security.application-groups (TEAMID.app.cutout) is needed by Electron's MAS build; @electron/osx-sign
     adds it automatically from the signing identity's team ID, so it isn't written here. No camera, microphone,
     USB, print, location or bookmarks (Cutout uses none). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
